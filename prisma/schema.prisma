// Mirror — Prisma schema (PostgreSQL)
// Phase 1 + 2 subset of the data model in docs/SPEC.md.

generator client {
  provider = "prisma-client-js"
}

// Connection: the URL lives in prisma.config.ts (migrations, Prisma 7) and src/lib/db.ts (runtime,
// through the node-postgres driver adapter).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5) tables
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  emailVerified          DateTime?
  image                  String?
  /// Account deletion requested: everything is removed at this time unless the person signs in first.
  deletionScheduledAt    DateTime?
  /// Phase 11e: a verified personal email that also signs in to this account (keeps Personal reachable after leaving a company).
  personalEmail          String?   @unique
  /// Phase 11e: pending personal email and the hash of its verification token.
  personalEmailPending   String?
  personalEmailTokenHash String?   @unique
  personalEmailTokenExp  DateTime?
  /// Age gate: passed the neutral age check (birth year and month are never stored), and accepted the terms.
  ageConfirmedAt         DateTime?
  termsAcceptedAt        DateTime?
  /// Age gate: under the minimum age. The account can't be used and is scheduled for deletion.
  ageBlockedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  profile     SubjectProfile?
  assessments Assessment[]
  auditLogs   AuditLog[]
  plans       DevelopmentPlan[]
  aiLogs      AIInteractionLog[]
  frameworks  Framework[]
  goals       Goal[]
  credits     CreditLedger[]

  coachProfile      CoachProfile?
  coachLinks        CoachClientLink[] @relation("CoachLinks")
  clientLinks       CoachClientLink[] @relation("ClientLinks")
  coachNotes        CoachNote[]       @relation("CoachNotesWritten")
  coachMeetings     CoachMeeting[]    @relation("CoachMeetings")
  clientMeetings    CoachMeeting[]    @relation("ClientMeetings")
  orgMemberships    OrgMember[]
  chats             CoachChat[]
  shareLinks        ShareLink[]
  dashboards        Dashboard[]
  apiTokens         ApiToken[]
  subscriptions     Subscription[]
  payments          Payment[]
  entitlements      Entitlement[]
  personalWorkspace Workspace?        @relation("PersonalWorkspace")
  discounts         PriceDiscount[]   @relation("UserDiscounts")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Subject
// ---------------------------------------------------------------------------

model SubjectProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  displayName     String
  jobTitle        String?
  seniority       String?
  industry        String?
  /// Goal keys, see src/lib/goals.ts (promotion, new_role, leadership_growth, career_change, ...)
  goals           String[]
  feedbackTone    String    @default("balanced") // direct | balanced | gentle (used by AI summaries)
  /// Learning style used to tailor development plans: reading | video | practice | conversation
  learningStyle   String?
  /// AI model choice, see src/lib/ai/models.ts ("free" = Groq gpt-oss; premium ids are billed per use)
  aiModel         String    @default("free")
  /// Prepaid credits for paid features (1 credit = one AI-generated questionnaire). See CreditLedger.
  aiCredits       Int       @default(0)
  /// Weekly nudge email: day of week (0 = Sunday … 6 = Saturday), null = off (opt-in, Phase 7).
  nudgeDay        Int?
  nudgeLastSentAt DateTime?
  /// Benchmarks (Phase 8): closed reports on the built-in framework count anonymously unless this is true.
  benchmarkOptOut Boolean   @default(false)
  onboardedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Saved reminder message (with {fill-ins}) and tone, reused across 360s.
  reminderTemplate String?
  reminderTone     String?
}

// ---------------------------------------------------------------------------
// Frameworks
// ---------------------------------------------------------------------------

model Framework {
  id          String   @id @default(cuid())
  slug        String
  version     Int      @default(1)
  name        String
  description String
  isBuiltIn   Boolean  @default(true)
  /// Owner of a custom questionnaire (null for built-in frameworks).
  ownerId     String?
  /// builtin | custom (made in the free builder) | ai (generated, paid with a credit)
  source      String   @default("builtin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  competencies Competency[]
  assessments  Assessment[]

  /// Phase 11: the workspace this belongs to (null for built-in frameworks). Filled by a database trigger.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([slug, version])
  @@index([ownerId])
}

model Competency {
  id          String @id @default(cuid())
  frameworkId String
  key         String
  name        String
  description String
  order       Int

  framework Framework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([frameworkId, key])
}

enum QuestionType {
  RATING
  OPEN_TEXT
}

model Question {
  id           String       @id @default(cuid())
  competencyId String
  key          String
  type         QuestionType @default(RATING)
  /// Third-person wording shown to raters, e.g. "{name} communicates ideas clearly."
  text         String
  /// First-person wording shown in the self-assessment.
  selfText     String
  order        Int

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([competencyId, key])
}

// ---------------------------------------------------------------------------
// Assessments (a single 360)
// ---------------------------------------------------------------------------

enum AssessmentType {
  FULL_360
  PULSE
}

enum AssessmentStatus {
  DRAFT // created by the wizard, self-assessment not yet submitted
  READY // self-assessment submitted and locked, invites not sent
  COLLECTING // invites sent, raters responding
  CLOSED // collection finished, report available
}

model Assessment {
  id                    String           @id @default(cuid())
  subjectId             String
  frameworkId           String
  type                  AssessmentType   @default(FULL_360)
  status                AssessmentStatus @default(DRAFT)
  title                 String
  goal                  String
  inviteMessage         String
  /// Never lower than ANONYMITY_FLOOR (3), enforced in src/lib/anonymity.ts
  minRatersPerGroup     Int              @default(3)
  /// Manager results shown as their own group only if the subject opts in (raters are told).
  showManagerSeparately Boolean          @default(false)
  scaleMax              Int              @default(5)
  dueAt                 DateTime?
  selfLockedAt          DateTime?
  launchedAt            DateTime?
  closedAt              DateTime?
  /// Pulses point at the full 360 that starts their series (null for a full 360).
  rootAssessmentId      String?
  /// Position of this run within its survey (the root 360 is session 1; re-runs and pulses follow).
  sessionNumber         Int              @default(1)
  /// Optional label for the session, e.g. "Spring 2027" or "After the reorg".
  sessionLabel          String?
  /// Where this session took place (e.g. employer at the time). Used to group sessions.
  company               String?
  /// Free-form labels the subject adds (e.g. "promotion", "new role"). Lower-case, max 8.
  tags                  String[]         @default([])
  /// Set when an organization's 360 campaign started this assessment (Phase 6).
  orgCampaignId         String?
  /// Full 360 unlocked (Phase 9): more than 5 raters and PDF export on the free plan.
  unlockedAt            DateTime?
  /// Credits: how this session was paid for when it launched. FREE | PAID | VOUCHER | PRO | ROUND | GRANDFATHERED.
  billing               String?
  /// Hundredths of a credit taken for this session (after discounts), and when.
  chargedCredits        Int?
  chargedAt             DateTime?
  /// On a full 360: how often to run pulses (1-3 months), and when the next one is due.
  cadenceMonths         Int?
  nextPulseDueAt        DateTime?
  pulseReminderSentAt   DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  subject     User                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  framework   Framework            @relation(fields: [frameworkId], references: [id])
  root        Assessment?          @relation("Series", fields: [rootAssessmentId], references: [id], onDelete: Cascade)
  pulses      Assessment[]         @relation("Series")
  goals       Goal[]
  orgCampaign OrgCampaign?         @relation(fields: [orgCampaignId], references: [id], onDelete: SetNull)
  shareLinks  ShareLink[]
  chats       CoachChat[]
  questions   AssessmentQuestion[]
  raterGroups RaterGroup[]
  invites     RaterInvite[]
  submissions Submission[]
  reports     Report[]
  plans       DevelopmentPlan[]

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId        String    @default(dbgenerated())
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Phase 11: when this round 360's anonymous scores were added to RoundResult (never removed).
  roundContributedAt DateTime?

  /// Phase 11: set on a Personal copy of a company round report (the company's name at the time).
  copiedFrom String?

  @@index([subjectId])
  @@index([rootAssessmentId])
}

/// Snapshot of the questions used in one assessment, so framework edits never change past data.
model AssessmentQuestion {
  id            String       @id @default(cuid())
  assessmentId  String
  competencyKey String
  competency    String
  questionKey   String?
  type          QuestionType @default(RATING)
  text          String
  selfText      String
  order         Int
  /// Rater-language versions of custom statements: { es: { text, competency, machine }, ... } (built-ins use static packs).
  translations  Json?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses  Response[]
  comments   Comment[]

  @@index([assessmentId])
}

enum RaterGroupKind {
  SELF
  MANAGER
  PEER
  DIRECT_REPORT
  CLIENT
  OTHER
}

model RaterGroup {
  id             String         @id @default(cuid())
  assessmentId   String
  kind           RaterGroupKind
  name           String
  order          Int
  /// sha256 of an optional shareable group link token (anyone with the link can respond once).
  shareTokenHash String?        @unique

  assessment  Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  invites     RaterInvite[]
  submissions Submission[]

  @@index([assessmentId])
}

enum InviteStatus {
  INVITED
  STARTED
  SUBMITTED
  DECLINED
}

enum InviteChannel {
  EMAIL
  LINK
}

/// Who was asked. Never linked to answers after submission (see Submission).
model RaterInvite {
  id             String        @id @default(cuid())
  assessmentId   String
  raterGroupId   String
  name           String?
  email          String?
  channel        InviteChannel @default(EMAIL)
  /// sha256 of the token in the rater's link. The raw token is never stored.
  tokenHash      String        @unique
  status         InviteStatus  @default(INVITED)
  /// In-progress answers for save & resume. Cleared on submit.
  draft          Json?
  invitedAt      DateTime?
  startedAt      DateTime?
  submittedAt    DateTime?
  lastRemindedAt DateTime?
  reminderCount  Int           @default(0)
  /// A personal line for this rater only, added to their invitation and reminders.
  personalNote   String?
  /// A reminder written outside the sending window, sent at the next one: { message, byUserId, at }.
  queuedReminder Json?
  createdAt      DateTime      @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  raterGroup RaterGroup @relation(fields: [raterGroupId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// One completed questionnaire. Deliberately has NO link to RaterInvite, IP address or
/// user agent, so answers cannot be traced to a person even with database access.
model Submission {
  id           String   @id @default(uuid()) /// random v4: cuid embeds a timestamp
  assessmentId String
  raterGroupId String
  isSelf       Boolean  @default(false)
  /// Truncated to the day on write; never exposed through the API.
  submittedOn  DateTime @db.Date

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  raterGroup RaterGroup @relation(fields: [raterGroupId], references: [id], onDelete: Cascade)
  responses  Response[]
  comments   Comment[]

  @@index([assessmentId])
}

model Response {
  id                   String @id @default(uuid()) /// random v4: cuid embeds a timestamp
  submissionId         String
  assessmentQuestionId String
  /// null = "don't know / not observed"
  value                Int?

  submission Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, assessmentQuestionId])
}

enum CommentKind {
  COMPETENCY // optional comment on a competency (assessmentQuestionId points at its first question)
  START
  STOP
  CONTINUE
  GENERAL
}

model Comment {
  id                   String      @id @default(uuid()) /// random v4: cuid embeds a timestamp
  submissionId         String
  assessmentQuestionId String?
  competencyKey        String?
  kind                 CommentKind
  text                 String

  submission Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion? @relation(fields: [assessmentQuestionId], references: [id], onDelete: SetNull)
}

/// Frozen report computed when the assessment closes (prevents before/after diffing attacks).
model Report {
  id           String   @id @default(cuid())
  assessmentId String
  version      Int      @default(1)
  data         Json
  /// AI-written summary (Phase 3): { summary, strengths, growth, modelId, generatedAt }
  aiSummary    Json?
  /// AI grouping of written comments into themes, made on the subject's request.
  aiThemes     Json?
  generatedAt  DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

/// AI development plan for one assessment. `data` holds growth areas → actions, exercises,
/// resources, 30-60-90 milestones and helpers; action completion is tracked inside it.
model DevelopmentPlan {
  id           String   @id @default(cuid())
  assessmentId String
  userId       String
  data         Json
  modelId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED
}

/// Outbound email log. With EMAIL_PROVIDER=console this doubles as the dev outbox.
model Notification {
  id        String             @id @default(cuid())
  channel   String             @default("email")
  to        String
  template  String
  subject   String
  body      String
  status    NotificationStatus @default(QUEUED)
  provider  String
  error     String?
  /// Shown as the sender, e.g. "Alex Silva via Mirror" (the address is always Mirror's).
  fromName  String?
  /// Replies go here (the person who asked for feedback).
  replyTo   String?
  createdAt DateTime           @default(now())
  sentAt    DateTime?
}

/// Addresses that asked for no more emails from Mirror (unsubscribe link in every non-essential email).
/// Sign-in links and email confirmations are still sent: the person asked for them.
model EmailSuppression {
  email     String   @id
  source    String   @default("link") // link | one-click | admin
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  /// Organization the event belongs to (org audit log, Phase 10).
  orgId     String?
  /// Whose data was touched (personal activity log, Phase 10).
  subjectId String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([orgId, createdAt])
  @@index([subjectId, createdAt])
}

/// One-time, short-lived ticket that turns a verified SSO login into an app session.
model SsoTicket {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Metering for every AI call. Never stores prompts or outputs (they may contain feedback),
/// only who/what/how much, for rate limits and per-use billing of premium models.
model AIInteractionLog {
  id           String   @id @default(cuid())
  userId       String?
  /// For calls without a signed-in user (rater de-identification): sha256 of the invite id.
  actorKey     String?
  feature      String // summary | plan | deidentify | framework | invite_message
  modelId      String // catalog id from src/lib/ai/models.ts
  provider     String
  tier         String // free | premium | mock
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Price charged to the user for this call, in micro-dollars (0 for free tier).
  costMicros   Int      @default(0)
  /// Hundredths of a credit taken for this request (premium models only).
  charged      Int      @default(0)
  status       String // ok | error | fallback
  error        String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Phase 11: the workspace this belongs to (null for rater-side calls with no account). Filled by a database trigger.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actorKey, createdAt])
  @@index([workspaceId, createdAt])
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

/// A development goal on one competency, tracked against later pulses in the same series.
model Goal {
  id             String     @id @default(cuid())
  userId         String
  /// The full 360 (series root) the goal belongs to.
  assessmentId   String
  competencyKey  String
  competencyName String
  title          String
  /// Others' average on this competency when the goal was set.
  baseline       Float?
  target         Float
  status         GoalStatus @default(ACTIVE)
  achievedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assessmentId])
}

/// Append-only record of credit changes (grants now; purchases once payments launch).
model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  /// Hundredths of a credit. Positive = added, negative = spent.
  delta        Int
  /// Balance of the workspace's wallet after this entry.
  balanceAfter Int?
  /// The company, for entries in a company wallet.
  orgId        String?
  /// purchase | grant | refund | survey | pulse | round | coach_gift | ai_premium | conversion
  reason       String
  /// e.g. the framework id a credit was spent on, or a payment id.
  ref          String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Fixed-window request counters for public endpoints. Keys are HMACs of a scope + identifier
/// (IP, token hash or email), never raw values, and per-IP and per-token counters are separate
/// rows so they can't be joined to link a rater to a network address.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

// ---------------------------------------------------------------- Phase 5: coach workspace

/// A user who coaches others. Free for now (coach plans come with payments in Phase 9).
model CoachProfile {
  userId            String   @id
  displayName       String
  /// White-label: shown on shared reports and PDFs of clients who opted in.
  brandName         String?
  /// Hex colour, e.g. "#2563eb".
  brandColor        String?
  website           String?
  /// Marketplace (Phase 9): listed coaches appear in /coaches once a platform admin has verified them.
  listed            Boolean  @default(false)
  verified          Boolean  @default(false)
  headline          String?
  bio               String?
  specialties       String[] @default([])
  languages         String[] @default([])
  /// Price of one coaching session, in cents (shown in the marketplace; paid to the coach directly).
  sessionPriceCents Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CoachLinkStatus {
  PENDING
  ACTIVE
  DECLINED
  REVOKED
}

/// A coach–client relationship. The client decides what is shared and can revoke at any time.
model CoachClientLink {
  id               String          @id @default(cuid())
  coachId          String?
  clientId         String?
  /// Who sent the invitation: COACH (to a client's email) or CLIENT (to a coach's email).
  initiatedBy      String
  inviteEmail      String
  inviteTokenHash  String?         @unique
  status           CoachLinkStatus @default(PENDING)
  /// What the client shares. Reports = frozen, anonymised report data (scores and themes).
  shareReports     Boolean         @default(true)
  /// Verbatim rater comments inside shared reports (off by default).
  shareComments    Boolean         @default(false)
  shareGoals       Boolean         @default(true)
  sharePlan        Boolean         @default(false)
  /// Show the coach's branding on the client's own reports and PDFs.
  showBranding     Boolean         @default(true)
  /// Phase 11e: coaching offered and paid for by a company (null = arranged privately).
  orgId            String?
  /// Phase 11e: for company offers, when the employee accepted (the coach is invited after that).
  clientAcceptedAt DateTime?
  createdAt        DateTime        @default(now())
  acceptedAt       DateTime?
  endedAt          DateTime?

  coach  User?         @relation("CoachLinks", fields: [coachId], references: [id], onDelete: Cascade)
  client User?         @relation("ClientLinks", fields: [clientId], references: [id], onDelete: Cascade)
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([coachId, status])
  @@index([clientId, status])
  @@index([orgId])
}

/// Private notes a coach keeps about a client. Never shown to the client.
model CoachNote {
  id        String   @id @default(cuid())
  coachId   String
  clientId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach User @relation("CoachNotesWritten", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, clientId])
}

/// A scheduled coaching conversation (shown to both coach and client).
model CoachMeeting {
  id          String   @id @default(cuid())
  coachId     String
  clientId    String
  scheduledAt DateTime
  topic       String   @default("")
  createdAt   DateTime @default(now())

  coach  User @relation("CoachMeetings", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientMeetings", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, scheduledAt])
  @@index([clientId, scheduledAt])
}

// ---------------------------------------------------------------- Phase 6: teams and organizations

/// An organization that runs 360s for its people. Free until payments (Phase 9).
model Organization {
  id                  String    @id @default(cuid())
  name                String
  /// Smallest number of people behind any group-level figure an admin sees (never below 5).
  minGroupSize        Int       @default(5)
  /// Participant seats for 360 rounds (Phase 9). New orgs get 10 free; one seat per person per round.
  seats               Int       @default(0)
  /// Data residency (Phase 10): "us" | "eu". EU orgs never send round data to non-EU AI providers.
  region              String    @default("us")
  /// Raw rater answers in this org's rounds are deleted this many months after a 360 closes (null = keep).
  retentionMonths     Int?
  /// Enterprise SSO (OIDC). The email domain must be verified by DNS before SSO can be switched on.
  ssoDomain           String?   @unique
  ssoDomainToken      String?
  ssoDomainVerifiedAt DateTime?
  ssoIssuer           String?
  ssoClientId         String?
  /// AES-256-GCM, key derived from AUTH_SECRET.
  ssoClientSecret     String?
  ssoEnabled          Boolean   @default(false)
  /// People with the domain must use SSO (magic links are refused).
  ssoRequired         Boolean   @default(false)
  createdById         String
  createdAt           DateTime  @default(now())

  members           OrgMember[]
  groups            OrgGroup[]
  campaigns         OrgCampaign[]
  workspace         Workspace?        @relation("CompanyWorkspace")
  roundResults      RoundResult[]
  coachingLinks     CoachClientLink[]
  /// Phase 11: people who leave may copy their own round reports to Personal (without raw comments).
  allowPersonalCopy Boolean           @default(true)
  /// Phase 11e: premium AI models people may use in this workspace (the free model is always allowed).
  allowedAiModels   String[]          @default([])
  /// Phase 11e: company plan paid until (null = never paid; new companies get a free trial).
  platformPaidUntil DateTime?
  /// Phase 11e: monthly premium-AI budget for the whole workspace, in cents (null = no limit).
  aiBudgetCents     Int?
  /// Phase 11e: monthly premium-AI budget per person, in cents (null = no limit).
  aiPerPersonCents  Int?
  priceDiscounts    PriceDiscount[]
}

enum OrgRole {
  OWNER
  ADMIN
  ANALYST
  MEMBER
}

enum OrgMemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// A person in an organization. Admins see aggregates; individual results only with this member's consent.
model OrgMember {
  id              String          @id @default(cuid())
  orgId           String
  userId          String?
  email           String
  name            String          @default("")
  role            OrgRole         @default(MEMBER)
  status          OrgMemberStatus @default(INVITED)
  inviteTokenHash String?         @unique
  /// Consent: admins may open this member's closed org 360 reports (scores and themes, no verbatim comments).
  shareReports    Boolean         @default(false)
  /// Consent: this member appears by name on the talent grid.
  shareTalentGrid Boolean         @default(false)
  /// Admin-entered performance rating for the talent grid (1 low · 2 medium · 3 high). Never shown to raters.
  performance     Int?
  invitedAt       DateTime        @default(now())
  joinedAt        DateTime?

  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups OrgGroupMember[]

  /// Phase 11: when the person left or was removed.
  exitedAt     DateTime?
  /// Phase 11: their company-workspace data is deleted at this time (7-day grace). Cleared once done or if they rejoin.
  exitPurgeAt  DateTime?
  /// Phase 11: when they copied their reports to Personal.
  exitCopiedAt DateTime?

  @@unique([orgId, email])
  @@index([userId])
  @@index([exitPurgeAt])
}

enum OrgGroupKind {
  TEAM
  COHORT
}

/// A team (people who work together) or a cohort (e.g. a leadership programme intake).
model OrgGroup {
  id        String       @id @default(cuid())
  orgId     String
  kind      OrgGroupKind
  name      String
  createdAt DateTime     @default(now())

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members   OrgGroupMember[]
  campaigns OrgCampaign[]

  @@unique([orgId, kind, name])
}

model OrgGroupMember {
  groupId  String
  memberId String

  group  OrgGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
}

/// An org-run 360: every member of the group gets their own 360 on the same questionnaire.
model OrgCampaign {
  id          String    @id @default(cuid())
  orgId       String
  groupId     String?
  name        String
  frameworkId String
  /// Team 360: teammates are suggested as peer raters for each other.
  teamMode    Boolean   @default(false)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group       OrgGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assessments Assessment[]

  @@index([orgId])
}

// ---------------------------------------------------------------- Phase 7: personalization v2

enum ChatMode {
  REPORT
  ROLEPLAY
}

/// A conversation with the AI coach about one report, or a role-play of a difficult conversation.
model CoachChat {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String?
  mode         ChatMode @default(REPORT)
  title        String
  /// Role-play: who the AI plays and the situation.
  scenario     String?
  /// free | premium (premium conversations cost 1 credit when started)
  tier         String   @default("free")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String // user | assistant
  content   String
  /// Report facts the reply relied on, e.g. ["Communication: others 3.2"].
  citations String[] @default([])
  createdAt DateTime @default(now())

  chat CoachChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

enum ShareKind {
  BADGE
  SUMMARY
  REPORT
}

/// A public, revocable link to something the subject chose to share. Private by default: nothing is
/// public until the subject creates a link. The id is the unguessable public slug.
model ShareLink {
  id           String    @id
  userId       String
  assessmentId String
  kind         ShareKind
  /// SUMMARY: which sections to show (strengths, growth, chart, narrative).
  sections     String[]  @default([])
  /// Optional note shown on the page, e.g. "Shared with my mentor".
  note         String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  views        Int       @default(0)
  createdAt    DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- Phase 8: analytics v2

/// Anonymous benchmark norm for one competency on a built-in framework, for one slice of people.
/// Only percentiles are stored (never individual values), and only when n meets the threshold.
model BenchmarkNorm {
  id            String   @id @default(cuid())
  frameworkSlug String
  competencyKey String
  /// "all", "seniority:Senior", "goal:promotion", ...
  slice         String
  n             Int
  mean          Float
  p10           Float
  p25           Float
  p50           Float
  p75           Float
  p90           Float
  computedAt    DateTime @default(now())

  @@unique([frameworkSlug, competencyKey, slice])
}

enum DashboardScope {
  PERSONAL
  COACH
  ORG
}

/// A user-built dashboard of widgets over data they can already see (same privacy rules).
model Dashboard {
  id          String         @id @default(cuid())
  ownerId     String
  scope       DashboardScope @default(PERSONAL)
  orgId       String?
  name        String
  /// [{ id, type, config }] — see src/lib/dashboards/widgets.ts
  widgets     Json           @default("[]")
  /// Scheduled email of this dashboard: null (off) | weekly | monthly
  schedule    String?
  /// weekly: day of week 0–6; monthly: day of month 1–28
  scheduleDay Int?
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// Personal read-only API token. Only a hash is stored; the token is shown once.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  /// First characters, to recognise the token in Settings.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- Phase 9: payments and marketplace

/// A plan for a period: PRO (individuals, yearly), COACH_STARTER / COACH_PRO (monthly). FREE has no row.
model Subscription {
  id               String    @id @default(cuid())
  userId           String
  plan             String
  status           String    @default("ACTIVE") // ACTIVE | CANCELED (runs to period end) | EXPIRED
  currentPeriodEnd DateTime
  provider         String // stub | stripe
  providerRef      String?
  createdAt        DateTime  @default(now())
  canceledAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// One checkout. Fulfilment is idempotent (keyed on this id) whichever provider confirms it.
model Payment {
  id          String    @id @default(cuid())
  userId      String
  product     String
  amountCents Int
  currency    String    @default("usd")
  status      String    @default("PENDING") // PENDING | PAID | CANCELED | REFUNDED
  provider    String
  providerRef String?
  /// e.g. { assessmentId } or { orgId, seats }
  context     Json      @default("{}")
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  fulfilledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Prepaid units: full_360 unlocks (bought or gifted by a coach) and coach report credits.
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  kind      String // full_360 | coach_report_credit
  remaining Int
  source    String // purchase | coach_gift | grant
  ref       String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Phase 11: the workspace this belongs to. Filled by a database trigger when not given.
  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// A client who found their coach in the marketplace. The referral fee is billed to the coach.
model MarketplaceReferral {
  id         String    @id @default(cuid())
  coachId    String
  clientId   String
  linkId     String    @unique
  feeCents   Int
  status     String    @default("PENDING") // PENDING (request sent) | ACCEPTED (fee due) | DECLINED
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([coachId, status])
}

/// A server error, grouped by fingerprint (built-in monitoring; no third-party service).
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  stack       String?
  route       String?
  kind        String    @default("server") // server | client | job
  count       Int       @default(1)
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([lastSeen])
}

// ---------------------------------------------------------------- Phase 11: workspaces

enum WorkspaceKind {
  PERSONAL
  COMPANY
}

/// Every piece of user content belongs to exactly one workspace: the owner's Personal space or a company.
model Workspace {
  id        String        @id @default(cuid())
  kind      WorkspaceKind
  /// PERSONAL: the owner.
  ownerId   String?       @unique
  /// COMPANY: the organization (1:1).
  orgId     String?       @unique
  createdAt DateTime      @default(now())
  /// Credit balance in hundredths of a credit ($1 = 1 credit). Personal = the person's, company = the company's.
  credits   Int           @default(0)

  owner User?         @relation("PersonalWorkspace", fields: [ownerId], references: [id], onDelete: Cascade)
  org   Organization? @relation("CompanyWorkspace", fields: [orgId], references: [id], onDelete: Cascade)

  assessments   Assessment[]
  frameworks    Framework[]
  plans         DevelopmentPlan[]
  goals         Goal[]
  chats         CoachChat[]
  dashboards    Dashboard[]
  shareLinks    ShareLink[]
  apiTokens     ApiToken[]
  aiLogs        AIInteractionLog[]
  creditLedger  CreditLedger[]
  subscriptions Subscription[]
  payments      Payment[]
  entitlements  Entitlement[]
}

/// Frozen, anonymous running totals of a company round, per scope ("org" or an OrgGroup id).
/// Added to when a round 360 closes; never reduced when someone leaves or deletes their account.
/// No user or assessment id is stored. Shown only when `people` meets the org's minimum group size.
model RoundResult {
  id           String   @id @default(cuid())
  orgId        String
  campaignId   String
  /// "org" for everyone in the round, or an OrgGroup id (membership at the time the 360 closed).
  scope        String
  people       Int      @default(0)
  /// { [competencyKey]: { name, n, sum, sumSq, selfN, selfSum } }
  competencies Json     @default("{}")
  overallN     Int      @default(0)
  overallSum   Float    @default(0)
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([campaignId, scope])
  @@index([orgId])
}

/// Every rater reminder, sent, queued or skipped, and round reminders to participants.
/// Rater rows identify the invitation (the subject already sees each rater's status), never answers.
model ReminderLog {
  id           String   @id @default(cuid())
  assessmentId String?
  inviteId     String?
  campaignId   String?
  memberId     String?
  sentById     String?
  /// AUTO (scheduled job) | MANUAL (subject) | ROUND (company admin to a participant)
  kind         String
  /// SENT | QUEUED | SKIPPED
  outcome      String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([assessmentId, createdAt])
  @@index([campaignId, createdAt])
  @@index([inviteId])
}

/// Pricing policy (one row, id "default"). Edited by platform admins at /admin/pricing; never hard-coded.
/// Amounts are hundredths of a credit ($1 = 1 credit = 100).
model PricingPolicy {
  id                    String   @id @default("default")
  survey360             Int      @default(4900)
  followUp              Int      @default(4900)
  pulse                 Int      @default(900)
  coachGift             Int      @default(3500)
  companyParticipant    Int      @default(1200)
  companyWelcomeCredits Int      @default(12000)
  freeSurveys           Int      @default(1)
  /// Premium AI price as a percentage of provider cost (200 = cost x 2).
  premiumMarkupPct      Int      @default(200)
  /// Fees added to a top-up and paid by the buyer: percentage in basis points plus a fixed amount in cents.
  cardFeeBps            Int      @default(290)
  cardFeeFixedCents     Int      @default(30)
  otherFeeBps           Int      @default(0)
  otherFeeFixedCents    Int      @default(0)
  minTopUp              Int      @default(1)
  maxTopUp              Int      @default(10000)
  updatedAt             DateTime @updatedAt
  updatedById           String?
}

/// A percentage off for one company or one person. The best active discount applies; they don't stack.
model PriceDiscount {
  id          String    @id @default(cuid())
  orgId       String?
  userId      String?
  percent     Int
  /// ALL | SURVEYS | AI
  scope       String    @default("ALL")
  note        String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?         @relation("UserDiscounts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

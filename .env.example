# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local:  postgresql://mirror:mirror@localhost:5432/mirror?schema=public
# Neon / Supabase: paste the pooled connection string and add ?sslmode=require
DATABASE_URL="postgresql://mirror:mirror@localhost:5432/mirror?schema=public"
# Optional: direct (non-pooled) connection used only for migrations. On Neon this is the
# same string without "-pooler" in the host. Leave empty locally.
DIRECT_DATABASE_URL=""

# --- Auth.js ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional Google sign-in (free). Leave blank to hide the Google button.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ------------------------------------------------------------------------
# Public base URL used in rater links, magic links and PDF rendering.
APP_URL="http://localhost:3000"   # leave empty on Vercel: the deployment URL is used automatically

# --- Email ----------------------------------------------------------------------
# console = no provider; emails are logged and stored in the Notification table and
# shown at /dev/outbox when DEV_TOOLS_ENABLED=true. A real provider is an open decision
# (see docs/STATUS.md); add it in src/lib/email/.
EMAIL_PROVIDER="console"
EMAIL_FROM="Mirror <no-reply@mirror.local>"

# --- Jobs -----------------------------------------------------------------------
# Shared secret for GET /api/cron/reminders (send as "Authorization: Bearer <secret>").
CRON_SECRET=""

# --- Deployment ---------------------------------------------------------------
# Re-create the demo account (demo@mirror.local) on every Vercel build. Safe: only touches
# the demo user and its data.
SEED_DEMO_ON_BUILD="false"

# --- Development only -----------------------------------------------------------
# NEVER enable these on a public deployment.
# DEV_TOOLS_ENABLED: shows /dev/outbox (contains magic links and rater links).
# DEMO_LOGIN_ENABLED: one-click "Sign in as demo user" on the sign-in page.
DEV_TOOLS_ENABLED="false"
DEMO_LOGIN_ENABLED="false"

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash scripts/vercel-build.sh",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "17 14 * * 1-5"
    }
  ],
  "functions": {
    "src/app/api/assessments/[id]/report/pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/health/route.ts": {
      "maxDuration": 60
    }
  }
}
